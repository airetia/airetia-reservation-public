###############################################################################
# airetia 認証API テストファイル
# 
# 使い方:
# 1. VSCode拡張機能「REST Client」をインストール
# 2. 各リクエストの上にある「Send Request」をクリック
# 3. レスポンスが右側に表示される
#
# 注意:
# - ローカル環境（localhost:8080）を前提
# - 実行前にバックエンドが起動していることを確認
# - ### で区切られた各セクションは独立して実行可能
###############################################################################

@baseUrl = http://localhost:8080
@apiVersion = v1

###############################################################################
# 1. ヘルスチェック（起動確認）
###############################################################################

### 1-1. Hello World（認証不要）
GET {{baseUrl}}/api/hello
Accept: application/json


###############################################################################
# 2. 会員登録
###############################################################################

### 2-1. 会員登録 - 成功ケース
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "太郎",
  "lastName": "山田",
  "firstNameKana": "たろう",
  "lastNameKana": "やまだ",
  "email": "yamada.taro@example.com",
  "password": "Password123",
  "birthDate": "1990-01-15",
  "gender": "MALE",
  "postalCode": "1500001",
  "address": "東京都渋谷区神宮前1-1-1",
  "phoneNumber": "09012345678"
}

### 2-2. 会員登録 - 別ユーザー（保護者）
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "花子",
  "lastName": "佐藤",
  "firstNameKana": "はなこ",
  "lastNameKana": "さとう",
  "email": "sato.hanako@example.com",
  "password": "SecurePass456",
  "birthDate": "1985-05-20",
  "gender": "FEMALE",
  "postalCode": "1600023",
  "address": "東京都新宿区西新宿2-8-1",
  "phoneNumber": "08098765432"
}

### 2-3. 会員登録 - サービス提供者予定ユーザー
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "次郎",
  "lastName": "田中",
  "firstNameKana": "じろう",
  "lastNameKana": "たなか",
  "email": "tanaka.jiro@example.com",
  "password": "Teacher2024!",
  "birthDate": "1988-12-10",
  "gender": "MALE",
  "postalCode": "1050011",
  "address": "東京都港区芝公園4-2-8",
  "phoneNumber": "07011112222"
}

### 2-4. 会員登録 - バリデーションエラー（メールアドレス形式不正）
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "テスト",
  "lastName": "ユーザー",
  "firstNameKana": "てすと",
  "lastNameKana": "ゆーざー",
  "email": "invalid-email",
  "password": "Password123",
  "birthDate": "1995-03-25",
  "gender": "MALE",
  "postalCode": "1234567",
  "address": "東京都",
  "phoneNumber": "09011112222"
}

### 2-5. 会員登録 - バリデーションエラー（パスワード要件不足）
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "テスト",
  "lastName": "ユーザー",
  "firstNameKana": "てすと",
  "lastNameKana": "ゆーざー",
  "email": "test.user@example.com",
  "password": "weak",
  "birthDate": "1995-03-25",
  "gender": "MALE",
  "postalCode": "1234567",
  "address": "東京都",
  "phoneNumber": "09011112222"
}

### 2-6. 会員登録 - 重複エラー（既存メールアドレス）
# 注意: 2-1を先に実行してから実行すること
POST {{baseUrl}}/api/{{apiVersion}}/auth/register
Content-Type: application/json

{
  "firstName": "重複",
  "lastName": "テスト",
  "firstNameKana": "ちょうふく",
  "lastNameKana": "てすと",
  "email": "yamada.taro@example.com",
  "password": "Password123",
  "birthDate": "1992-07-18",
  "gender": "MALE",
  "postalCode": "1234567",
  "address": "東京都",
  "phoneNumber": "09099998888"
}


###############################################################################
# 3. ログイン
###############################################################################

### 3-1. ログイン - 成功ケース
# @name login
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "yamada.taro@example.com",
  "password": "Password123"
}

### 3-2. ログイン - 別ユーザー（保護者）
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "sato.hanako@example.com",
  "password": "SecurePass456"
}

### 3-3. ログイン - サービス提供者予定ユーザー
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "tanaka.jiro@example.com",
  "password": "Teacher2024!"
}

### 3-4. ログイン - 失敗（パスワード不正）
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "yamada.taro@example.com",
  "password": "WrongPassword"
}

### 3-5. ログイン - 失敗（存在しないメールアドレス）
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "notexist@example.com",
  "password": "Password123"
}

### 3-6. ログイン - バリデーションエラー（メールアドレス未入力）
POST {{baseUrl}}/api/{{apiVersion}}/auth/login
Content-Type: application/json

{
  "email": "",
  "password": "Password123"
}


###############################################################################
# 4. 認証状態確認
###############################################################################

### 4-1. 現在のユーザー情報取得（ログイン後実行）
# 注意: 先にログイン（3-1）を実行してセッションを確立すること
GET {{baseUrl}}/api/{{apiVersion}}/auth/me
Accept: application/json


###############################################################################
# 5. ログアウト
###############################################################################

### 5-1. ログアウト
# 注意: ログイン状態で実行すること
POST {{baseUrl}}/api/{{apiVersion}}/auth/logout


###############################################################################
# 6. パスワードリセット（Phase 1実装予定）
###############################################################################

### 6-1. パスワードリセット要求
# POST {{baseUrl}}/api/{{apiVersion}}/auth/password-reset/request
# Content-Type: application/json
# 
# {
#   "email": "yamada.taro@example.com"
# }

### 6-2. パスワードリセット実行
# POST {{baseUrl}}/api/{{apiVersion}}/auth/password-reset/confirm
# Content-Type: application/json
# 
# {
#   "token": "reset-token-here",
#   "newPassword": "NewPassword123"
# }


###############################################################################
# 7. セッション管理テスト
###############################################################################

### 7-1. セッション有効期限テスト
# 1. ログイン（3-1）を実行
# 2. 30分待機（application.ymlのセッションタイムアウト設定）
# 3. 以下のリクエストを実行 → 401 Unauthorized になるはず
# GET {{baseUrl}}/api/{{apiVersion}}/auth/me


###############################################################################
# 8. CSRF対策テスト（Phase 2以降）
###############################################################################

### 8-1. CSRFトークンなしでPOST（エラーになるはず）
# 注意: SecurityConfigでCSRF有効化後に実行
# POST {{baseUrl}}/api/{{apiVersion}}/auth/login
# Content-Type: application/json
# 
# {
#   "email": "yamada.taro@example.com",
#   "password": "Password123"
# }


###############################################################################
# 9. 管理者ログインテスト（Phase 1後半）
###############################################################################

### 9-1. 管理者ログイン
# 注意: 管理者アカウントを事前に作成しておくこと
# POST {{baseUrl}}/api/{{apiVersion}}/auth/login
# Content-Type: application/json
# 
# {
#   "email": "admin@airetia.com",
#   "password": "AdminPassword123!"
# }